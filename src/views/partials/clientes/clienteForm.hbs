<div class="car card-body p-4 rounded-0 bg-dark text-white">
  <h4 class="text-center">Agregar el cliente</h4>

  <form action="/clientes/agregar" method="Post">

    <div>
      <label for="nombre">Escribe nombre:</label>
      <input
        type="text"
        name="nombre"
        placeholder="Nombre"
        id="nombre"
        class="form-control bg-dark text-white"
      />
    </div>

    <div>
      <label for="apellido">Escribe apellido:</label>
      <input
        type="text"
        name="apellido"
        placeholder="Apellido"
        id="apellido"
        class="form-control bg-dark text-white"
      />
    </div>

    <div>
      <label for="correo">Escribe correo:</label>
      <input
        type="email"
        name="correo"
        placeholder="Correo"
        id="correo"
        class="form-control bg-dark text-white"
      />
    </div>

    <div>
      <label for="telefono">Escribe teléfono:</label>
      <input
        type="text"
        name="telefono"
        placeholder="Teléfono"
        id="telefono"
        class="form-control bg-dark text-white"
      />
    </div>

    <div>
      <label for="direccion">Escribe dirección:</label>
      <input
        type="text"
        name="direccion"
        placeholder="Dirección"
        id="direccion"
        class="form-control bg-dark text-white"
      />
    </div>

    <div>
      <label for="edad">Escribe edad:</label>
      <input
        type="number"
        name="edad"
        placeholder="Edad"
        id="edad"
        class="form-control bg-dark text-white"
      />
    </div>

    <div class="mt-2">
      <label for="activo">Activo:</label>
      <input type="checkbox" name="activo" value="true" checked />
    </div>

    <button class="btn btn-success btn-sm mt-2">
      Agregar
    </button>

  </form>
</div>